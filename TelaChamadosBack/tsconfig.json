{
  "compilerOptions": {
    //"target": "es5",       
    "target": "ES2017",
    "alwaysStrict":true,                   
    "module": "commonjs",                    
    "lib": [ "es2018", "DOM" ],                     
    "allowJs": true,
    "checkJs":false,
    "moduleResolution":"node",
    "outDir": "build",                          
    "rootDir": "src",
    "strict": true,         
    "noImplicitAny": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.js",
  ],
}